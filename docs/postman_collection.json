{
  "info": {
    "_postman_id": "bb5d1072-0e00-4d31-a825-c01ba2ca1c87",
    "name": "Travel Companion Finder API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
