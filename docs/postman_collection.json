        },
        {
          "name": "Allow Request",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": \"GROUP_ID\",\n  \"user_id\": \"USER_ID\"\n}"
            },
            "url": "{{base_url}}/group/allow"
          }
        },
        {
          "name": "Reject Request",
          "request": {
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}" }] },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"group_id\": \"GROUP_ID\",\n  \"user_id\": \"USER_ID\"\n}"
